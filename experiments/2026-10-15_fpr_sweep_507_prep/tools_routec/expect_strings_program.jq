def hexoff: gsub("(?<![0-9a-f.])([0-9a-f]{64}|[0-9a-f]{40})(?![0-9a-f])"; "x"); def numlike: test("^[+-]?([0-9]+[.]?[0-9]*|[.][0-9]+)([eE][+-]?[0-9]+)?$|^[+-]?(nan|inf|infinity)$"; "i") and (test("^([0-9a-f]{40}|[0-9a-f]{64})$") | not); def embed: (hexoff | test("[.][0-9]|[0-9][eE][+-]?[0-9]|%|(?<![A-Za-z0-9])(nan|inf(inity)?)(?![A-Za-z0-9])"; "i")); def refused: (test("^[A-Za-z0-9._/@|:-]{1,400}$") | not) or numlike or embed; def pinnable: (length > 0) and (length <= 400) and (numlike | not) and (embed | not) and (explode | all(. >= 32 and . != 127)); ([.plan | .. | objects | keys[]] + [.plan | paths(type == "string") as $p | getpath($p)]) | map(select(refused and pinnable)) | unique
