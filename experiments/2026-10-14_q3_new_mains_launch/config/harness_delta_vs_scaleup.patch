+    assert record.get("construction") == NEW_MAINS_V1 and record["sol_system_sha256"] is None \
+        and record["sol_input_sha256"] is None, f"{cell}: not a new_mains_v1 record"
+    assert _sha(record["approach"]) == record["approach_sha256"] == record["q2_approach_sha256"], (
+        f"{cell}: the approach isn't the fleet rule's (q2's per-side-task record)")
+    (sample,) = list(built.dataset)
+    assert sample.metadata["attack_approach"] in ("", record["approach"]), f"{cell}: the registry's approach differs"
+    sample.metadata["attack_approach"] = record["approach"]
+    md = sample.metadata
+    fields = {"main": md["main_task"]["description"], "side": md["side_task_text"],
+              "env": md["environment"]["description"], "approach": md["attack_approach"].strip()}  # the renderer strips it
+    assert not any(m in v for m in _MASK.values() for v in fields.values()), f"{cell}: a field holds a sentinel"
+    masked = attacker_prompt(main_task=_MASK["main"], side_task=_MASK["side"], environment=_MASK["env"],
+                             attack_approach=_MASK["approach"] if fields["approach"] else "", filename=prompt_name)
+    assert _sha(masked) == TEMPLATE_196[bool(fields["approach"])], f"{cell}: the masked template differs from the 196's"
+    system = attacker_prompt(main_task=fields["main"], side_task=fields["side"], environment=fields["env"],
+                             attack_approach=md["attack_approach"], filename=prompt_name)
+    filled = masked
+    for k, v in fields.items():
+        filled = filled.replace(_MASK[k], v)
+    assert system == filled, f"{cell}: system prompt is not the template with this cell's fields"
+    assert isinstance(sample.input, str) and sample.input == "", f"{cell}: first user message isn't ''"
+    built.provenance = {"system_sha256": _sha(system), "input_sha256": _sha(sample.input)}  # not logged; hashes only
+    if os.environ.get("PHASE2_RECORD_PROVENANCE") == "1":
+        assert record.get("provenance_system_sha256") is None, f"{cell}: provenance is already recorded"
+    else:
+        assert built.provenance["system_sha256"] == record.get("provenance_system_sha256"), f"{cell}: provenance differs"
+    return built
+
+
+def attack_task(kind: str):
+    """The attack entry point (kind "real" or "sim") for BA_CELLS' record in PHASE2_CELLS: legacy unless the record
+    says new_mains_v1. For the preflights (build_real_samples.py, check_sim_samples.py)."""
+    cells = {c["cell"]: c for c in json.loads(Path(os.environ["PHASE2_CELLS"]).read_text())["cells"]}
+    new = cells[os.environ["BA_CELLS"]].get("construction", "legacy_sol_hash") == NEW_MAINS_V1
+    return {"real": (la_real_attack_sept, la_real_attack_new_mains_v1),
+            "sim": (la_sim_attack_sept, la_sim_attack_new_mains_v1)}[kind][new]
+
+
+@task
+def la_real_attack_new_mains_v1() -> Task:
+    arena = linuxarena(required_environment_name())
+    settings = RealTaskSettings.from_environment(arena)
+    assert settings.mode is Mode.ATTACK and len(settings.cells) == 1 and not settings.real_logs, settings
+    return _build_new_mains_v1(real_task(arena, settings), settings.cells[0], settings.attacker_prompt)
+
+
+@task
+def la_sim_attack_new_mains_v1() -> Task:
+    arena = linuxarena(required_environment_name())
+    settings = SimulatedTaskSettings.from_environment(arena)
+    assert settings.mode is Mode.ATTACK and len(settings.cells) == 1 and settings.fork_fraction == 0.0, settings
+    assert settings.real_logs == settings.honest_logs, "the reference is the fork source, as in September"
+    return _build_new_mains_v1(sim_task(arena, settings), settings.cells[0], settings.attacker_prompt)
