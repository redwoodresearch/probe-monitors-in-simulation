+# ---------- G2: repaired-plus (PLAN.md here) ----------
+def slots(msgs):
+    """Per tool message index: (step, action, tool name, text_editor command), paired to calls by order as fixes.calls_of
+    pairs them; step and action as positions() counts them."""
+    import sys
+    if "/root" not in sys.path:
+        sys.path.insert(0, "/root")
+    from rerender import args_of
+    out, step, action, pending = {}, -1, 0, []
+    for i, m in enumerate(msgs):
+        if m["role"] == "assistant":
+            step, action = step + 1, 0
+            pending = [((tc.get("function") or {}).get("name"), args_of(tc.get("function") or {}).get("command")) for tc in (m.get("tool_calls") or [])]
+        elif m["role"] == "tool":
+            name, cmd = pending.pop(0) if pending else (None, None)
+            out[i] = (step, action, name, cmd); action += 1
+    return out
+
+
+def d4(msgs):
+    """D4: R8's edit (fixes_round2._r8_edit, text.rstrip("\\n")) on every create, insert and str_replace output, except
+    harness-truncated and non-text ones. Returns the new messages and the outputs changed per command."""
+    from collections import Counter
+    out, n = [dict(m) for m in msgs], Counter()
+    for i, (_, _, name, cmd) in slots(msgs).items():
+        c = msgs[i].get("content")
+        if name == "text_editor" and cmd in CMDS and isinstance(c, str) and TRUNC not in c and c.endswith("\n"):
+            out[i]["content"] = c.rstrip("\n"); n[cmd] += 1
+    return out, n
+
+
+def r6(text, row):
+    """R6 (clock.shift_text, frozen) on `text` with the run's recorded offset and "now" (v2's fixed_sim record)."""
+    import sys
+    from datetime import timedelta
+    if "/root" not in sys.path:
+        sys.path.insert(0, "/root")
+    import clock
+    ck = row["fixed_sim"]["clock"]
+    return None if ck["now"] is None else clock.shift_text(text, timedelta(seconds=ck["offset_s"]), datetime.fromisoformat(ck["now"]))[0]
+
