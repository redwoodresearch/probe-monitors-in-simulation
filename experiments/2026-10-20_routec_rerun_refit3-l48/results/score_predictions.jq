# score_predictions.jq: refit3-l48's pre-stated predictions scored against the launch's structured line, by key name.
# Every value is a comparison (a boolean); no number from the line is printed. Run: jq -c -f score_predictions.jq <result_line.json>
# Sources: PRESTATED §4 (probabilities and count predictions), AMEND1 A4 (P(D2 | D3) revised to 0.35), AMEND3 C3 / AMEND4 D2 (slot controls).
.refit3l48 as $r
| {
    "selftest_all_pass": ($r.selftest_all_pass == true),
    "gates_G1_G4_pass": ($r.gates | [.G1, .G2, .G3, .G4] | all),
    "pass_field_true": ($r.pass == true),
    "P0.9__D3_MATCH": ($r.verdict.D3 == "MATCH"),
    "P0.35_given_D3__D2_all_three_MATCH": ($r.verdict.D2.i == true and $r.verdict.D2.ii == true and $r.verdict.D2.iii == "MATCH"),
    "D2_i_c_run_scores_MATCH": ($r.verdict.D2.i == true),
    "D2_ii_run2_run_scores_MATCH": ($r.verdict.D2.ii == true),
    "D2_iii_is_MATCH": ($r.verdict.D2.iii == "MATCH"),
    "D2_iii_is_NO_VERDICT": ($r.verdict.D2.iii == "NO VERDICT"),
    "P0.9__STATS_MATCH": ($r.diagnostics.stats_match == true),
    "STATS_MATCH_std_units": ($r.diagnostics.stats_match_std_units == true),
    "STORED_CERT": ($r.diagnostics.stored_cert == true),
    "RESID_EXPLAINED": ($r.diagnostics.resid_explained == true),
    "MY_FIT_ERR_le_1e-6": ($r.diagnostics["my_fit_err_le_1e-6"] == true),
    "MY_CERTIFIED": ($r.diagnostics.my_certified == true),
    "D3_bound_le_1e-9": ($r.diagnostics["d3_bound_le_1e-9"] == true),
    "AUROC_DEF": ($r.diagnostics.auroc_def_match == true),
    "dhat_max_le_1e-4": ($r.diagnostics.dhat_max_le["1e-4"] == true),
    "dhat_max_le_1e-3": ($r.diagnostics.dhat_max_le["1e-3"] == true),
    "dhat_max_le_1e-2": ($r.diagnostics.dhat_max_le["1e-2"] == true),
    "rank_identical": ($r.reading.rank_identical == true),
    "slot23_port_repro": ($r.diagnostics.slot23.port_repro == true),
    "slot23_port_repro_all": ($r.diagnostics.slot23.port_repro_all == true),
    "slot23_unchanged_printed": ($r.diagnostics.slot23.unchanged_printed == true),
    "slot23_unchanged_all": ($r.diagnostics.slot23.unchanged_all == true),
    "pred_FAIL__PC_SLOT23_x_eq_y": ($r.diagnostics.slot23.pc_x_eq_y_failed_as_predicted == true),
    "pred_FAIL__PC_port_swap": ($r.diagnostics.slot23.pc_port_swap_failed_as_predicted == true),
    "pred_FAIL__PC_D2_vs_L63": ($r.controls_failed_as_predicted.PC_D2_vs_L63 == true),
    "pred_FAIL__PC_D3a_perturbed_w": ($r.controls_failed_as_predicted.PC_D3a_perturbed_w == true),
    "pred_FAIL__PC_D3b_wrong_npz": ($r.controls_failed_as_predicted.PC_D3b_wrong_npz == true),
    "count_runs_3939": ($r.counts.runs == 3939),
    "count_mains_864": ($r.counts.mains == 864),
    "count_staged_files_75": ($r.counts.staged_files == 75),
    "count_metas_3939": ($r.counts.metas == 3939),
    "count_runs_with_rows_3933": ($r.counts.runs_with_rows == 3933),
    "count_zero_row_runs_6": (($r.counts.runs - $r.counts.runs_with_rows) == 6),
    "count_chunks_829": ($r.counts.chunks == 829),
    "count_chunks_read_829": ($r.counts.chunks_read == 829),
    "count_c_runs_1309_1311": ($r.counts.c_runs == {"class1": 1309, "class0": 1311}),
    "count_run2_runs_1313": ($r.counts.run2_runs == 1313),
    "count_folds_certified_5": ($r.counts.folds_certified == 5),
    "count_keys_resid_3933": ($r.counts.keys_resid == 3933),
    "count_D2_keys_2620_1313": ($r.compare.D2_c.n_compared == 2620 and $r.compare.D2_run2.n_compared == 1313),
    "count_D3_keys_2620_1313": ($r.compare.D3_c.n_compared == 2620 and $r.compare.D3_run2.n_compared == 1313),
    "D2_c_keys_equal": ($r.compare.D2_c.keys_equal == true),
    "D2_run2_keys_equal": ($r.compare.D2_run2.keys_equal == true),
    "D3_c_n_over_tol_0": ($r.compare.D3_c.n_over_tol == 0),
    "D3_run2_n_over_tol_0": ($r.compare.D3_run2.n_over_tol == 0),
    "D2_c_n_over_tol_0": ($r.compare.D2_c.n_over_tol == 0),
    "D2_run2_n_over_tol_0": ($r.compare.D2_run2.n_over_tol == 0),
    "g3_unused_nonfinite_0": ($r.g3_unused_rows.nonfinite_values == 0),
    "class_REPRODUCED": ($r.reading.class == "REPRODUCED"),
    "class_CERTIFIED_FIT_WITHIN_DELTA_HAT": ($r.reading.class == "CERTIFIED_FIT_WITHIN_DELTA_HAT"),
    "class_STOP_DEFINITION_GAP_OR_BUG": ($r.reading.class == "STOP_DEFINITION_GAP_OR_BUG"),
    "class_STOP_D3": ($r.reading.class == "STOP_D3"),
    "class_NO_VERDICT": ($r.reading.class == "NO_VERDICT"),
    "ruling_REPRODUCED": ($r.reading.ruling_09 == "REPRODUCED"),
    "ruling_PASS_value_half": ($r.reading.ruling_09 == "PASS (value half)"),
    "ruling_UNRESOLVED": ($r.reading.ruling_09 == "UNRESOLVED"),
    "label_pass_ranks": ($r.reading.label == "x = the stored certified fit; exact optimum within max|Δ̂|; printed Spearman unaffected"),
    "label_pass_slot": ($r.reading.label == "x = the stored certified fit; exact optimum within max|Δ̂|; printed slot 23 values unchanged at print rounding (recomputed from the refit x)"),
    "label_x_reproduced": ($r.reading.label == "x reproduced"),
    "label_reproduced_no_auroc": ($r.reading.label == "x reproduced; refit3 run-level AUROC not compared (AUROC definition not identified)"),
    "disclosures_empty": ($r.reading.disclosures == []),
    "rank_swaps_x_0": ($r.reading.rank_swaps.x == 0),
    "rank_swaps_null_0": ($r.reading.rank_swaps.null == 0),
    "diag_reply_class_REPRODUCED": ($r.diagnostic_cells["reply|L48"].reading.class == "REPRODUCED"),
    "diag_reply_class_CERTIFIED": ($r.diagnostic_cells["reply|L48"].reading.class == "CERTIFIED_FIT_WITHIN_DELTA_HAT"),
    "diag_reply_ruling_PASS_value_half": ($r.diagnostic_cells["reply|L48"].reading.ruling_09 == "PASS (value half)"),
    "diag_reply_ruling_REPRODUCED": ($r.diagnostic_cells["reply|L48"].reading.ruling_09 == "REPRODUCED"),
    "diag_reply_has_error": ($r.diagnostic_cells["reply|L48"] | has("error"))
  }
