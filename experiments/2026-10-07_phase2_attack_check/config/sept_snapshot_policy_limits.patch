+# Opt-in limits on every policy model call, read here because `build_policy_model` is the one function every
+# path that builds a policy goes through (real and simulated arms, both arenas), so the arms cannot differ in
+# them. Unset, a run is configured exactly as before: a 600 s attempt, retried until the run's time limit, and
+# no output cap.
+#   PT_POLICY_ATTEMPT_TIMEOUT  seconds one attempt may take. An attempt that runs out is not retried: Inspect's
+#                              `timeout` is set to the same value, and Inspect starts no retry once that much time
+#                              has passed since the call began, so the call fails with AttemptTimeoutError and the
+#                              sample with it. A retry after a fast transient error still gets a full attempt.
+#   PT_POLICY_MAX_RETRIES      Inspect's retries for transient errors (connection resets, 5xx).
+#   PT_POLICY_MAX_TOKENS       output tokens per call.
+# Providers built on the OpenAI SDK also retry connection errors and 5xx twice inside each Inspect attempt. An eval's
+# own --timeout or --max-retries still wins over these (Inspect merges them over every model's config), so a run
+# that sets these variables must not pass those flags.
+POLICY_LIMIT_VARIABLES = ("PT_POLICY_ATTEMPT_TIMEOUT", "PT_POLICY_MAX_RETRIES", "PT_POLICY_MAX_TOKENS")
+# The OpenAI SDK's own read timeout. A non-streamed completion sends nothing until it is done, so the SDK aborts
+# any call longer than this and resends it, inside one Inspect attempt. An attempt timeout above it is only real
+# if the client's timeout is raised with it, which `build_policy_model` does for these providers.
+OPENAI_SDK_READ_TIMEOUT = 600
+OPENAI_SDK_PROVIDERS = ("openai", "openai-api", "vllm")
+
+
+def _policy_limit(name: str) -> int | None:
+    value = os.environ.get(name, "").strip()
+    return int(value) if value else None
+
+
+# Opt-in, with PT_POLICY_ATTEMPT_TIMEOUT: a policy call that times out ends the episode where it is, without an error,
+# instead of failing the sample. The sample keeps the conversation up to that call and records
+# `policy_ended_by = "policy_timeout"` in its store (`runner.build.arena_policy`), so a run that hit a timeout is kept
+# and counted rather than redrawn or lost. Unset, a timed-out call fails the sample, as before.
+POLICY_TIMEOUT_ENDS_EPISODE = "PT_POLICY_TIMEOUT_ENDS_EPISODE"
+
+
+class PolicyTimeout(Exception):
+    """A policy call ran out its attempt timeout under PT_POLICY_TIMEOUT_ENDS_EPISODE. Carries the conversation the call
+    was given, which is the episode's transcript up to the call that never answered."""
+
+    def __init__(self, messages: list) -> None:
+        super().__init__("policy call timed out; the episode ends here")
+        self.messages = messages
+
+
+def _is_attempt_timeout(error: BaseException) -> bool:
+    """Inspect's AttemptTimeoutError (not exported), raised directly or as the last attempt of tenacity's RetryError."""
+    last = getattr(error, "last_attempt", None)
+    error = last.exception() if last is not None and last.failed else error
+    return type(error).__name__ == "AttemptTimeoutError"
+
+
+def _end_episode_on_timeout(model: Model) -> Model:
+    generate = model.generate
+
+    async def guarded(input, *args, **kwargs):  # noqa: A002 — Model.generate's own parameter name
+        try:
+            return await generate(input, *args, **kwargs)
+        except Exception as error:
+            if _is_attempt_timeout(error):
+                raise PolicyTimeout([input] if isinstance(input, str) else list(input)) from error
+            raise
+
+    model.generate = guarded
+    return model
+
 
