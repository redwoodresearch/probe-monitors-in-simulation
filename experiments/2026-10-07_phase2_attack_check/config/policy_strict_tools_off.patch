+def _send_tools_unstrict(model: Model) -> None:
+    """Mark every tool "strict": false in this model's requests. Set on the API instance, which outlives the vllm
+    provider's lazy re-initialisation (that resets its strict_tools attribute to True); a provider without the hook
+    fails here rather than silently sending strict tools."""
+    api = model.api
+    original = api.tools_to_openai
+
+    def tools_to_openai(tools):  # type: ignore[no-untyped-def]
+        converted = original(tools)
+        for tool in converted:
+            tool["function"]["strict"] = False
+        return converted
+
+    api.tools_to_openai = tools_to_openai
+
