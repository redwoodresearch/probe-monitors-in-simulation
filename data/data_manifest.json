  "honest_{side}_main": "int16 [units]: index into main_tasks.csv of the unit's run",
  "honest_{side}_run": "int32 [units]: index of the unit's run within this side's honest runs",
  "honest_{side}_run_main": "int16 [runs]: main task of each admitted honest run on this side, including runs with no scored units (runs with no output at all are listed in honest_runs_without_output.csv)",
  "{arm}_score / _fold / _fold_scores / _cell": "the units of each attack run, as above, with the cell (index into cells.csv) instead of a run",
  "{arm}_zero_unit_cells": "int32: cells whose attack run has no scored units (never caught)",
  "cells_used": "int32: cells (index into cells.csv) in this probe x readout's comparison (all three attack runs present)"
 },
 "multiplicities": "row 0 = original data; rows 1..10,000 = resamples of the 902 main tasks, stratified by environment"
